{
	"name": "atb",
	"version": "1.0.0",
	"homepage": "https://andrewbosley.github.io/atb",
	"private": true,
	"scripts": {
		"dev": "vite dev --open",
		"updates": "npm outdated",
		"latest": "npx npm-check-updates",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"build": "vite build",
		"preview": "vite build && vite preview",
		"deploy": "npm run build && npx gh-pages -d build -t --cname andrewtbosley.com"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.9.3",
		"@sveltejs/kit": "^2.50.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/eslint": "^9.6.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"gh-pages": "^6.3.0",
		"globals": "^17.0.0",
		"prettier": "^3.8.0",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.46.4",
		"svelte-check": "^4.3.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.0",
		"vite": "^7.3.1"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "1.1.1"
		}
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.2.8",
		"@fontsource/permanent-marker": "^5.2.7",
		"@master/normal.css": "^3.2.0",
		"lucide-svelte": "^0.562.0"
	}
}
